// Step 1 (foundation): plans, schools, users, sessions, audit log, files, school invoices.
// Every school-owned table carries schoolId. Queries must always filter by the caller's schoolId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  PRINCIPAL
  STAFF
  TEACHER
  STUDENT
  PARENT
}

enum SchoolStatus {
  TRIAL
  ACTIVE
  READ_ONLY
  SUSPENDED
}

enum FileCategory {
  LOGO
  PROFILE_PHOTO
  STUDENT_DOCUMENT
  STAFF_DOCUMENT
  SYLLABUS
  STUDY_MATERIAL
  SCHOOL_DOCUMENT
  GALLERY
  CHAT
  HOMEWORK
  EXAM
  OTHER
}

enum InvoiceStatus {
  UNPAID
  PAID
  VOID
}

model Plan {
  id               String   @id @default(cuid())
  name             String   @unique @db.VarChar(80)
  description      String?  @db.VarChar(500)
  monthlyPrice     Decimal  @db.Decimal(12, 2)
  /// Active students covered by monthlyPrice.
  includedStudents Int
  /// Charged for each active student above includedStudents.
  perStudentPrice  Decimal  @db.Decimal(12, 2)
  /// Hard cap on active students; null = no cap.
  maxStudents      Int?
  /// Hard cap on staff + teacher accounts; null = no cap.
  maxStaff         Int?
  maxCampuses      Int      @default(1)
  storageLimitMb   Int
  maxFileSizeMb    Int
  /// Module keys enabled on this plan (see src/config/modules.ts).
  modules          Json
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  schools          School[]
}

model School {
  id                   String       @id @default(cuid())
  name                 String       @db.VarChar(160)
  /// Short unique code, e.g. "city-grammar".
  code                 String       @unique @db.VarChar(60)
  address              String?      @db.VarChar(300)
  city                 String?      @db.VarChar(80)
  phone                String?      @db.VarChar(40)
  email                String?      @db.VarChar(160)
  logoFileId           String?
  status               SchoolStatus @default(TRIAL)
  trialEndsAt          DateTime?
  planId               String
  plan                 Plan         @relation(fields: [planId], references: [id])
  /// Per-school overrides of plan limits (null = use plan).
  customStorageLimitMb Int?
  customMaxStudents    Int?
  customMaxStaff       Int?
  timezone             String       @default("Asia/Karachi") @db.VarChar(60)
  currency             String       @default("PKR") @db.VarChar(8)
  /// Day of month the subscription invoice is due.
  billingDay           Int          @default(10)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?

  /// School settings, e.g. { requiredStudentFields: string[] }.
  settings Json?

  campuses Campus[]
  users    User[]
  files    StoredFile[]
  invoices SchoolInvoice[]
  audits   AuditLog[]

  @@index([status])
}

model Campus {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id])
  name      String    @db.VarChar(120)
  address   String?   @db.VarChar(300)
  isMain    Boolean   @default(false)
  createdAt DateTime  @default(now())
  sections  Section[]

  @@index([schoolId])
}

model User {
  id                 String    @id @default(cuid())
  /// Null only for SUPER_ADMIN.
  schoolId           String?
  school             School?   @relation(fields: [schoolId], references: [id])
  role               Role
  /// Login name, unique across the platform.
  username           String    @unique @db.VarChar(80)
  email              String?   @unique @db.VarChar(160)
  phone              String?   @db.VarChar(40)
  fullName           String    @db.VarChar(160)
  passwordHash       String    @db.VarChar(100)
  mustChangePassword Boolean   @default(true)
  isActive           Boolean   @default(true)
  /// Permission keys for STAFF (see src/config/permissions.ts). Principal has all.
  permissions        Json?
  photoFileId        String?
  lastLoginAt        DateTime?
  /// Bumped to invalidate every access token of this user (logout everywhere, password reset).
  tokenVersion       Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  sessions         RefreshSession[]
  staffProfile     StaffProfile?
  student          Student?
  family           Family?
  classTeacherOf   Section[]
  teachingSubjects TeachingAssignment[]
  TimetableEntry   TimetableEntry[]

  @@index([schoolId, role])
}

model RefreshSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  /// Set when this token was rotated; reuse of a rotated token revokes the whole family.
  replacedBy String?
  userAgent  String?   @db.VarChar(300)
  ip         String?   @db.VarChar(64)
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id])
  actorId    String?
  actorRole  Role?
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(60)
  entityId   String?  @db.VarChar(40)
  before     Json?
  after      Json?
  reason     String?  @db.VarChar(500)
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([entityType, entityId])
}

model StoredFile {
  id           String       @id @default(cuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id])
  uploadedById String
  category     FileCategory
  storageKey   String       @unique @db.VarChar(300)
  originalName String       @db.VarChar(255)
  mimeType     String       @db.VarChar(120)
  sizeBytes    Int
  createdAt    DateTime     @default(now())
  /// Soft-deleted files no longer count towards storage usage.
  deletedAt    DateTime?

  @@index([schoolId, deletedAt])
  @@index([schoolId, category])
}

model SchoolInvoice {
  id               String        @id @default(cuid())
  schoolId         String
  school           School        @relation(fields: [schoolId], references: [id])
  /// Billing month, "YYYY-MM".
  period           String        @db.VarChar(7)
  planName         String        @db.VarChar(80)
  basePrice        Decimal       @db.Decimal(12, 2)
  includedStudents Int
  activeStudents   Int
  extraStudents    Int
  perStudentPrice  Decimal       @db.Decimal(12, 2)
  amount           Decimal       @db.Decimal(12, 2)
  status           InvoiceStatus @default(UNPAID)
  dueDate          DateTime
  paidAmount       Decimal?      @db.Decimal(12, 2)
  paidAt           DateTime?
  paymentMethod    String?       @db.VarChar(40)
  paymentRef       String?       @db.VarChar(120)
  notes            String?       @db.VarChar(500)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([schoolId, period])
  @@index([status, dueDate])
}

// ---------------------------------------------------------------------------
// Step 2: school setup and people
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  LEFT
  STRUCK_OFF
  GRADUATED
  TRANSFERRED
}

enum AdmissionType {
  NEW
  TRANSFER
  READMISSION
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
}

/// Per-school running numbers (admission numbers, family numbers, employee numbers).
model SchoolCounter {
  schoolId String
  key      String @db.VarChar(40)
  value    Int    @default(0)

  @@id([schoolId, key])
}

model AcademicSession {
  id        String    @id @default(cuid())
  schoolId  String
  name      String    @db.VarChar(40)
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  isCurrent Boolean   @default(false)
  createdAt DateTime  @default(now())
  students  Student[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ClassLevel {
  id        String         @id @default(cuid())
  schoolId  String
  name      String         @db.VarChar(60)
  /// Subject group for higher classes, e.g. "Pre-Medical".
  stream    String?        @db.VarChar(60)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  deletedAt DateTime?
  sections  Section[]
  subjects  ClassSubject[]
  students  Student[]

  @@index([schoolId, sortOrder])
}

model Section {
  id             String               @id @default(cuid())
  schoolId       String
  classId        String
  class          ClassLevel           @relation(fields: [classId], references: [id])
  name           String               @db.VarChar(20)
  campusId       String?
  campus         Campus?              @relation(fields: [campusId], references: [id])
  capacity       Int?
  room           String?              @db.VarChar(40)
  classTeacherId String?
  classTeacher   User?                @relation(fields: [classTeacherId], references: [id])
  createdAt      DateTime             @default(now())
  deletedAt      DateTime?
  students       Student[]
  assignments    TeachingAssignment[]
  timetable      TimetableEntry[]

  @@index([schoolId])
  @@index([classId])
}

model Subject {
  id          String               @id @default(cuid())
  schoolId    String
  name        String               @db.VarChar(80)
  code        String?              @db.VarChar(20)
  createdAt   DateTime             @default(now())
  deletedAt   DateTime?
  classes     ClassSubject[]
  assignments TeachingAssignment[]
  timetable   TimetableEntry[]

  @@index([schoolId])
}

model ClassSubject {
  classId    String
  class      ClassLevel @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  isOptional Boolean    @default(false)

  @@id([classId, subjectId])
}

/// Which teacher teaches which subject in which section.
model TeachingAssignment {
  id        String   @id @default(cuid())
  schoolId  String
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id])
  createdAt DateTime @default(now())

  @@unique([sectionId, subjectId])
  @@index([schoolId, teacherId])
}

model StaffProfile {
  id            String    @id @default(cuid())
  schoolId      String
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  employeeNo    String    @db.VarChar(30)
  designation   String?   @db.VarChar(80)
  cnic          String?   @db.VarChar(20)
  gender        Gender?
  dob           DateTime? @db.Date
  qualification String?   @db.VarChar(160)
  joiningDate   DateTime? @db.Date
  salary        Decimal?  @db.Decimal(12, 2)
  address       String?   @db.VarChar(300)
  campusId      String?
  /// { name, relation, phone }
  emergency     Json?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([schoolId, employeeNo])
}

/// A household: siblings share one family and one parent login.
model Family {
  id           String     @id @default(cuid())
  schoolId     String
  familyNo     String     @db.VarChar(20)
  parentUserId String?    @unique
  parentUser   User?      @relation(fields: [parentUserId], references: [id])
  createdAt    DateTime   @default(now())
  guardians    Guardian[]
  students     Student[]

  @@unique([schoolId, familyNo])
}

model Guardian {
  id               String           @id @default(cuid())
  schoolId         String
  familyId         String
  family           Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  relation         GuardianRelation
  /// For GUARDIAN: uncle, grandmother, ...
  relationDetail   String?          @db.VarChar(40)
  fullName         String           @db.VarChar(160)
  cnic             String?          @db.VarChar(20)
  phone            String?          @db.VarChar(30)
  whatsapp         String?          @db.VarChar(30)
  email            String?          @db.VarChar(160)
  occupation       String?          @db.VarChar(100)
  organization     String?          @db.VarChar(160)
  education        String?          @db.VarChar(100)
  monthlyIncome    Int?
  officeAddress    String?          @db.VarChar(300)
  address          String?          @db.VarChar(300)
  isDeceased       Boolean          @default(false)
  /// Receives WhatsApp messages and alerts.
  receivesMessages Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([schoolId, cnic])
  @@index([schoolId, phone])
  @@index([familyId])
}

model Student {
  id            String           @id @default(cuid())
  schoolId      String
  userId        String?          @unique
  user          User?            @relation(fields: [userId], references: [id])
  familyId      String
  family        Family           @relation(fields: [familyId], references: [id])
  admissionNo   String           @db.VarChar(30)
  admissionDate DateTime         @db.Date
  admissionType AdmissionType    @default(NEW)
  sessionId     String?
  session       AcademicSession? @relation(fields: [sessionId], references: [id])
  classId       String
  class         ClassLevel       @relation(fields: [classId], references: [id])
  sectionId     String?
  section       Section?         @relation(fields: [sectionId], references: [id])
  rollNo        String?          @db.VarChar(20)
  status        StudentStatus    @default(ACTIVE)
  statusDate    DateTime?        @db.Date
  statusReason  String?          @db.VarChar(300)

  fullName         String    @db.VarChar(160)
  nameUrdu         String?   @db.VarChar(160)
  gender           Gender
  dob              DateTime? @db.Date
  placeOfBirth     String?   @db.VarChar(80)
  bForm            String?   @db.VarChar(20)
  religion         String?   @db.VarChar(40)
  nationality      String?   @db.VarChar(40)
  motherTongue     String?   @db.VarChar(40)
  bloodGroup       String?   @db.VarChar(5)
  currentAddress   String?   @db.VarChar(300)
  permanentAddress String?   @db.VarChar(300)
  city             String?   @db.VarChar(80)
  area             String?   @db.VarChar(80)
  phone            String?   @db.VarChar(30)
  email            String?   @db.VarChar(160)
  photoFileId      String?

  /// { name, relation, phone }
  emergencyContact  Json?
  /// { schoolName, lastClass, year, marks, reasonForLeaving, slcNo }
  previousSchool    Json?
  /// { allergies, conditions, medicines, specialNeeds, doctorName, doctorPhone }
  health            Json?
  feeCategory       String?  @db.VarChar(60)
  discountType      String?  @db.VarChar(60)
  discountPercent   Decimal? @db.Decimal(5, 2)
  /// Fixed amount off each month (on discountable heads), in addition to the percentage.
  discountAmount    Decimal? @db.Decimal(12, 2)
  transportRequired Boolean  @default(false)
  notes             String?  @db.Text

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?
  documents StudentDocument[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, status, classId, sectionId])
  @@index([schoolId, fullName])
  @@index([familyId])
}

model StudentDocument {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  docType   String   @db.VarChar(40)
  fileId    String
  createdAt DateTime @default(now())

  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Step 3: bell schedules and timetables
// ---------------------------------------------------------------------------

/// A set of period timings, used on the weekdays listed in `days` (1 = Monday … 7 = Sunday).
/// Example: "Regular" for Mon–Thu and Sat, "Friday" for Fri.
model BellSchedule {
  id        String   @id @default(cuid())
  schoolId  String
  name      String   @db.VarChar(60)
  days      Json
  createdAt DateTime @default(now())
  periods   Period[]

  @@index([schoolId])
}

model Period {
  id         String           @id @default(cuid())
  scheduleId String
  schedule   BellSchedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  name       String           @db.VarChar(40)
  /// "HH:MM", 24-hour.
  startTime  String           @db.VarChar(5)
  endTime    String           @db.VarChar(5)
  isBreak    Boolean          @default(false)
  sortOrder  Int
  entries    TimetableEntry[]

  @@index([scheduleId])
}

/// One cell of a class timetable: a section, a weekday and a period.
model TimetableEntry {
  id        String   @id @default(cuid())
  schoolId  String
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  day       Int
  periodId  String
  period    Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId String?
  teacher   User?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  room      String?  @db.VarChar(40)
  /// Free text for slots without a subject, e.g. "Assembly", "Library".
  note      String?  @db.VarChar(60)
  updatedAt DateTime @updatedAt

  @@unique([sectionId, day, periodId])
  @@index([schoolId, teacherId, day, periodId])
}

// ---------------------------------------------------------------------------
// Step 4: attendance, messaging (WhatsApp + in-app notifications)
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HALF_DAY
}

/// One section's attendance for one day (exists once it has been marked).
model AttendanceSession {
  id          String   @id @default(cuid())
  schoolId    String
  sectionId   String
  date        DateTime @db.Date
  markedById  String
  markedAt    DateTime @default(now())
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@unique([sectionId, date])
  @@index([schoolId, date])
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  schoolId    String
  studentId   String
  sectionId   String
  date        DateTime         @db.Date
  status      AttendanceStatus
  remark      String?          @db.VarChar(200)
  /// Set when the absent/late alert for this day was queued, so parents are told only once.
  alertSentAt DateTime?
  updatedAt   DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([schoolId, date])
  @@index([sectionId, date])
}

/// Each school's own WhatsApp Business connection and message rules.
model MessagingSettings {
  schoolId          String    @id
  whatsappEnabled   Boolean   @default(false)
  phoneNumberId     String?   @db.VarChar(40)
  businessAccountId String?   @db.VarChar(40)
  /// AES-256-GCM encrypted.
  accessTokenEnc    String?   @db.Text
  appSecretEnc      String?   @db.Text
  /// Token Meta sends when verifying the webhook URL.
  verifyToken       String    @db.VarChar(64)
  displayPhone      String?   @db.VarChar(40)
  verifiedName      String?   @db.VarChar(160)
  status            String    @default("NOT_SET") @db.VarChar(20)
  lastError         String?   @db.VarChar(500)
  lastCheckedAt     DateTime?
  /// Calling code added to local numbers (03001234567 -> 923001234567).
  countryCode       String    @default("92") @db.VarChar(4)
  /// { [messageType]: "auto" | "manual" | "off" }
  rules             Json?
  /// { [messageType]: { name, language } } approved template names in Meta.
  templates         Json?
  updatedAt         DateTime  @updatedAt
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

/// A send to many people at once (manual message, a day's absent alerts).
model MessageBatch {
  id          String    @id @default(cuid())
  schoolId    String
  type        String    @db.VarChar(30)
  title       String    @db.VarChar(160)
  body        String    @db.Text
  /// What the sender chose, e.g. { kind: "classes", ids: [...] }
  audience    Json
  channels    Json
  total       Int       @default(0)
  createdById String
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  messages    Message[]

  @@index([schoolId, createdAt])
}

/// One WhatsApp message to one phone number (the outbox and the delivery log).
model Message {
  id                String        @id @default(cuid())
  schoolId          String
  batchId           String?
  batch             MessageBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  type              String        @db.VarChar(30)
  toPhone           String        @db.VarChar(20)
  toName            String?       @db.VarChar(160)
  studentId         String?
  templateName      String?       @db.VarChar(120)
  templateLanguage  String?       @db.VarChar(10)
  params            Json?
  /// The text as the parent will read it (for the log).
  body              String        @db.Text
  status            MessageStatus @default(QUEUED)
  error             String?       @db.VarChar(500)
  attempts          Int           @default(0)
  nextAttemptAt     DateTime      @default(now())
  providerMessageId String?       @unique @db.VarChar(120)
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime      @default(now())

  @@index([status, nextAttemptAt])
  @@index([schoolId, createdAt])
  @@index([batchId])
}

/// In-app notification (bell icon). Always sent, even when WhatsApp is off.
model Notification {
  id        String    @id @default(cuid())
  schoolId  String
  userId    String
  type      String    @db.VarChar(30)
  title     String    @db.VarChar(160)
  body      String    @db.Text
  link      String?   @db.VarChar(300)
  batchId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([schoolId, createdAt])
}

// ---------------------------------------------------------------------------
// Step 5: fees
// ---------------------------------------------------------------------------

enum FeeFrequency {
  /// Charged every month.
  MONTHLY
  /// Charged only in the months listed in FeeHead.months (e.g. annual charges in April).
  SELECTED_MONTHS
  /// Never automatic; added as a one-off charge (admission fee, trip, books).
  ONE_TIME
}

model FeeHead {
  id           String       @id @default(cuid())
  schoolId     String
  name         String       @db.VarChar(80)
  frequency    FeeFrequency @default(MONTHLY)
  /// Months (1-12) for SELECTED_MONTHS.
  months       Json?
  /// Student discounts (sibling, scholarship…) apply to this head.
  discountable Boolean      @default(true)
  sortOrder    Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  classFees    ClassFee[]

  @@index([schoolId])
}

/// Amount of a fee head for a class.
model ClassFee {
  classId String
  headId  String
  head    FeeHead @relation(fields: [headId], references: [id], onDelete: Cascade)
  amount  Decimal @db.Decimal(12, 2)

  @@id([classId, headId])
}

model FeeSettings {
  schoolId      String   @id
  /// Day of month the monthly voucher is due.
  dueDay        Int      @default(10)
  /// NONE | FIXED | PER_DAY
  lateFeeType   String   @default("NONE") @db.VarChar(10)
  lateFeeAmount Decimal  @default(0) @db.Decimal(12, 2)
  /// Cap for PER_DAY (0 = no cap).
  lateFeeMax    Decimal  @default(0) @db.Decimal(12, 2)
  /// Generate next month's vouchers automatically on the 1st.
  autoGenerate  Boolean  @default(false)
  /// { bankName, accountTitle, accountNumber, branch, iban }
  bankDetails   Json?
  voucherNote   String?  @db.VarChar(500)
  receiptPrefix String   @default("R") @db.VarChar(10)
  updatedAt     DateTime @updatedAt
}

enum FeeInvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

/// One fee voucher for one student (monthly, or a one-off charge).
model FeeInvoice {
  id             String                 @id @default(cuid())
  schoolId       String
  studentId      String
  familyId       String
  invoiceNo      String                 @db.VarChar(30)
  /// "YYYY-MM" for monthly vouchers; null for one-off charges.
  period         String?                @db.VarChar(7)
  title          String                 @db.VarChar(120)
  issueDate      DateTime               @db.Date
  dueDate        DateTime               @db.Date
  total          Decimal                @db.Decimal(12, 2)
  paidAmount     Decimal                @default(0) @db.Decimal(12, 2)
  status         FeeInvoiceStatus       @default(UNPAID)
  /// Late fee already added to this voucher.
  lateFeeApplied Boolean                @default(false)
  createdById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  lines          FeeInvoiceLine[]
  allocations    FeePaymentAllocation[]

  @@unique([schoolId, invoiceNo])
  @@index([schoolId, period])
  @@index([studentId, status])
  @@index([familyId, status])
}

model FeeInvoiceLine {
  id          String     @id @default(cuid())
  invoiceId   String
  invoice     FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  headId      String?
  /// MONTHLY | ONE_TIME | LATE_FEE | DISCOUNT | ADJUSTMENT
  kind        String     @db.VarChar(20)
  description String     @db.VarChar(160)
  /// Negative for discounts.
  amount      Decimal    @db.Decimal(12, 2)
}

enum FeePaymentStatus {
  VALID
  CANCEL_REQUESTED
  CANCELLED
}

/// A receipt. Covers one or more vouchers of one family; any amount not allocated is the family's credit.
model FeePayment {
  id                  String                 @id @default(cuid())
  schoolId            String
  receiptNo           String                 @db.VarChar(30)
  familyId            String
  /// Set when the payment was for one student only.
  studentId           String?
  amount              Decimal                @db.Decimal(12, 2)
  /// CASH | BANK | CHEQUE | ONLINE | OTHER
  method              String                 @db.VarChar(20)
  reference           String?                @db.VarChar(120)
  /// COUNTER (collected by staff) | ONLINE (paid by parent through the gateway)
  source              String                 @default("COUNTER") @db.VarChar(10)
  receivedAt          DateTime
  collectedById       String?
  handoverId          String?
  handover            FeeHandover?           @relation(fields: [handoverId], references: [id])
  status              FeePaymentStatus       @default(VALID)
  cancelReason        String?                @db.VarChar(300)
  cancelRequestedById String?
  cancelledById       String?
  cancelledAt         DateTime?
  note                String?                @db.VarChar(300)
  createdAt           DateTime               @default(now())
  allocations         FeePaymentAllocation[]

  @@unique([schoolId, receiptNo])
  @@index([schoolId, receivedAt])
  @@index([familyId])
  @@index([collectedById, handoverId])
}

model FeePaymentAllocation {
  id        String     @id @default(cuid())
  paymentId String
  payment   FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal    @db.Decimal(12, 2)

  @@index([invoiceId])
  @@index([paymentId])
}

enum HandoverStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Staff hand the money they collected to the principal, who approves it.
model FeeHandover {
  id             String         @id @default(cuid())
  schoolId       String
  staffId        String
  /// Total of the receipts included (expected).
  expectedAmount Decimal        @db.Decimal(12, 2)
  /// What the staff member says they are handing over.
  declaredAmount Decimal        @db.Decimal(12, 2)
  /// { CASH: n, BANK: n, … }
  byMethod       Json
  note           String?        @db.VarChar(300)
  status         HandoverStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?        @db.VarChar(300)
  createdAt      DateTime       @default(now())
  payments       FeePayment[]

  @@index([schoolId, status])
  @@index([staffId])
}

/// Each school's own payment gateway account (money goes straight to the school).
model PaymentGatewaySettings {
  schoolId         String   @id
  /// NONE | JAZZCASH | TEST
  provider         String   @default("NONE") @db.VarChar(20)
  enabled          Boolean  @default(false)
  merchantId       String?  @db.VarChar(60)
  passwordEnc      String?  @db.Text
  integritySaltEnc String?  @db.Text
  sandbox          Boolean  @default(true)
  allowPartial     Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model OnlinePayment {
  id          String    @id @default(cuid())
  schoolId    String
  familyId    String
  invoiceIds  Json
  amount      Decimal   @db.Decimal(12, 2)
  provider    String    @db.VarChar(20)
  txnRef      String    @unique @db.VarChar(40)
  /// INITIATED | SUCCESS | FAILED
  status      String    @default("INITIATED") @db.VarChar(12)
  message     String?   @db.VarChar(300)
  response    Json?
  paymentId   String?
  createdById String
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([schoolId, createdAt])
  @@index([familyId])
}

// ---------------------------------------------------------------------------
// Step 6: tests, exams, results and report cards
// ---------------------------------------------------------------------------

enum AssessmentKind {
  /// One subject, one section, made by a teacher (weekly, monthly, surprise test…).
  TEST
  /// Several subjects for a whole class with a date sheet (mid-term, final…).
  EXAM
}

/// Weekly test, Monthly test, Mid-term, Annual… Schools and teachers can add their own names.
model AssessmentType {
  id          String         @id @default(cuid())
  schoolId    String
  name        String         @db.VarChar(60)
  kind        AssessmentKind
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  createdById String?
  createdAt   DateTime       @default(now())
  assessments Assessment[]

  @@index([schoolId])
}

/// Grade bands, pass mark and publishing rules for a school.
model ExamSettings {
  schoolId            String   @id
  /// [{ grade: "A+", min: 90, remark: "Outstanding" }, …] highest first.
  gradeBands          Json
  passPercent         Decimal  @default(33) @db.Decimal(5, 2)
  /// Class tests need the principal's approval before students and parents see them.
  testsNeedApproval   Boolean  @default(true)
  showPositions       Boolean  @default(true)
  /// Online exam papers need the principal's approval before they go live.
  onlinePaperApproval Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model Assessment {
  id            String            @id @default(cuid())
  schoolId      String
  kind          AssessmentKind
  typeId        String
  type          AssessmentType    @relation(fields: [typeId], references: [id])
  title         String            @db.VarChar(120)
  /// Same value for every class of one school-wide exam.
  groupKey      String?           @db.VarChar(40)
  sessionId     String?
  classId       String
  /// Tests are for one section; exams cover every section of the class.
  sectionId     String?
  topic         String?           @db.VarChar(300)
  /// Exams: students and parents can see the date sheet.
  announced     Boolean           @default(false)
  /// DRAFT until results are published.
  status        String            @default("DRAFT") @db.VarChar(12)
  publishedAt   DateTime?
  publishedById String?
  createdById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  papers        AssessmentPaper[]
  results       StudentResult[]
  remarks       ResultRemark[]

  @@index([schoolId, kind, status])
  @@index([classId])
  @@index([groupKey])
}

/// One subject of an assessment (a test has exactly one).
model AssessmentPaper {
  id           String      @id @default(cuid())
  assessmentId String
  assessment   Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  subjectId    String
  date         DateTime?   @db.Date
  startTime    String?     @db.VarChar(5)
  totalMarks   Decimal     @db.Decimal(7, 2)
  passMarks    Decimal     @db.Decimal(7, 2)
  sortOrder    Int         @default(0)
  marks        Mark[]
  sheets       MarkSheet[]

  @@unique([assessmentId, subjectId])
}

/// Marks of one paper for one section, and where they are in the approval process.
model MarkSheet {
  id            String          @id @default(cuid())
  paperId       String
  paper         AssessmentPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  sectionId     String
  /// DRAFT → SUBMITTED → (RETURNED → SUBMITTED) → APPROVED
  status        String          @default("DRAFT") @db.VarChar(12)
  submittedById String?
  submittedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  returnNote    String?         @db.VarChar(500)
  updatedAt     DateTime        @updatedAt

  @@unique([paperId, sectionId])
}

model Mark {
  id          String          @id @default(cuid())
  paperId     String
  paper       AssessmentPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  studentId   String
  marks       Decimal?        @db.Decimal(7, 2)
  isAbsent    Boolean         @default(false)
  remark      String?         @db.VarChar(200)
  updatedById String?
  updatedAt   DateTime        @updatedAt

  @@unique([paperId, studentId])
  @@index([studentId])
}

/// Calculated when results are published (and again after any correction).
model StudentResult {
  id              String     @id @default(cuid())
  schoolId        String
  assessmentId    String
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId       String
  sectionId       String?
  obtained        Decimal    @db.Decimal(9, 2)
  total           Decimal    @db.Decimal(9, 2)
  percent         Decimal    @db.Decimal(5, 2)
  grade           String     @db.VarChar(5)
  passed          Boolean
  positionClass   Int?
  positionSection Int?
  absentPapers    Int        @default(0)
  updatedAt       DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([schoolId])
}

/// Report card remarks for a student in one exam.
model ResultRemark {
  id              String     @id @default(cuid())
  assessmentId    String
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId       String
  teacherRemark   String?    @db.VarChar(500)
  principalRemark String?    @db.VarChar(500)
  updatedAt       DateTime   @updatedAt

  @@unique([assessmentId, studentId])
}

// ---------------------------------------------------------------------------
// Step 7: online exams
// ---------------------------------------------------------------------------

enum QuestionType {
  MCQ
  MULTI
  TRUE_FALSE
  FILL
  MATCH
  SHORT
  LONG
}

/// Shared question bank of a school (teachers reuse each other's questions).
model BankQuestion {
  id          String       @id @default(cuid())
  schoolId    String
  subjectId   String
  classId     String?
  chapter     String?      @db.VarChar(120)
  type        QuestionType
  text        String       @db.Text
  imageFileId String?
  /// MCQ/MULTI: [{ id, text }]; MATCH: { left: string[], right: string[] }
  options     Json?
  /// MCQ: optionId; MULTI: optionId[]; TRUE_FALSE: boolean; FILL: string[][] (accepted answers per blank);
  /// MATCH: number[] (right index for each left item); SHORT/LONG: model answer text (optional).
  answer      Json?
  marks       Decimal      @default(1) @db.Decimal(6, 2)
  createdById String
  usedCount   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([schoolId, subjectId])
}

model OnlinePaper {
  id               String                @id @default(cuid())
  schoolId         String
  title            String                @db.VarChar(160)
  subjectId        String
  classId          String
  sectionIds       Json
  instructions     String?               @db.Text
  /// DRAFT → (AWAITING_APPROVAL) → SCHEDULED → RESULTS_SUBMITTED → (RESULTS_RETURNED) → PUBLISHED
  status           String                @default("DRAFT") @db.VarChar(20)
  startAt          DateTime?
  endAt            DateTime?
  durationMinutes  Int                   @default(30)
  shuffleQuestions Boolean               @default(true)
  shuffleOptions   Boolean               @default(true)
  /// Fraction of a question's marks taken off for a wrong MCQ / true-false answer (0 = none).
  negativeMarking  Decimal               @default(0) @db.Decimal(4, 2)
  /// Students see correct answers with their result.
  showAnswers      Boolean               @default(true)
  passMarks        Decimal?              @db.Decimal(7, 2)
  reviewNote       String?               @db.VarChar(500)
  /// Term-exam paper whose marks are filled from this online exam (scaled), if chosen.
  linkPaperId      String?
  /// Created when results are published so they appear with other results.
  assessmentId     String?
  createdById      String
  publishedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  sections         OnlinePaperSection[]
  questions        OnlinePaperQuestion[]
  attempts         OnlineAttempt[]

  @@index([schoolId, status])
  @@index([classId])
}

model OnlinePaperSection {
  id           String                @id @default(cuid())
  paperId      String
  paper        OnlinePaper           @relation(fields: [paperId], references: [id], onDelete: Cascade)
  title        String                @db.VarChar(120)
  instructions String?               @db.VarChar(500)
  /// "Attempt any N" (null = all questions).
  attemptAny   Int?
  sortOrder    Int                   @default(0)
  questions    OnlinePaperQuestion[]
}

/// A copy of the question inside the paper (editing the bank later does not change a running exam).
model OnlinePaperQuestion {
  id          String             @id @default(cuid())
  paperId     String
  paper       OnlinePaper        @relation(fields: [paperId], references: [id], onDelete: Cascade)
  sectionId   String
  section     OnlinePaperSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  bankId      String?
  type        QuestionType
  text        String             @db.Text
  imageFileId String?
  options     Json?
  answer      Json?
  marks       Decimal            @db.Decimal(6, 2)
  sortOrder   Int                @default(0)
}

model OnlineAttempt {
  id            String      @id @default(cuid())
  schoolId      String
  paperId       String
  paper         OnlinePaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  studentId     String
  startedAt     DateTime    @default(now())
  deadline      DateTime
  submittedAt   DateTime?
  autoSubmitted Boolean     @default(false)
  /// Question ids in the order this student sees them, and option order per question.
  questionOrder Json
  optionOrder   Json
  /// { [paperQuestionId]: answer }
  answers       Json
  /// { [paperQuestionId]: { auto: number|null, manual: number|null, remark: string|null } }
  marking       Json?
  overallRemark String?     @db.VarChar(500)
  score         Decimal?    @db.Decimal(8, 2)
  /// Times the student left the exam tab/app.
  tabSwitches   Int         @default(0)
  lastSavedAt   DateTime?
  updatedAt     DateTime    @updatedAt

  @@unique([paperId, studentId])
  @@index([studentId])
}

// ---------- Step 8: remarks, monthly reports, honors ----------

enum RemarkCategory {
  ACADEMIC
  BEHAVIOR
  DISCIPLINE
  APPRECIATION
  HEALTH
  OTHER
}

/// A teacher's or principal's remark about a student.
model StudentRemark {
  id          String         @id @default(cuid())
  schoolId    String
  studentId   String
  sectionId   String?
  category    RemarkCategory
  text        String         @db.VarChar(1000)
  date        DateTime       @db.Date
  /// false = internal (staff only); true = parents and the student can see it.
  shared      Boolean        @default(true)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  /// When parents were sent a WhatsApp message about it.
  sentAt      DateTime?
  deletedAt   DateTime?

  @@index([schoolId, studentId])
  @@index([schoolId, date])
}

/// Monthly progress report of one student (data is a snapshot taken when generated).
model MonthlyReport {
  id          String    @id @default(cuid())
  schoolId    String
  studentId   String
  sectionId   String?
  classId     String
  /// "YYYY-MM"
  period      String    @db.VarChar(7)
  data        Json
  /// Class teacher's comment for this month.
  comment     String?   @db.VarChar(600)
  commentById String?
  /// DRAFT until sent to parents.
  status      String    @default("DRAFT") @db.VarChar(10)
  generatedAt DateTime  @default(now())
  sentAt      DateTime?
  sentById    String?

  @@unique([studentId, period])
  @@index([schoolId, period])
}

model HonorType {
  id            String   @id @default(cuid())
  schoolId      String
  name          String   @db.VarChar(60)
  icon          String   @default("🏅") @db.VarChar(8)
  /// CLASS = one winner per class (e.g. Student of the Month); SCHOOL = whole school.
  scope         String   @default("CLASS") @db.VarChar(6)
  /// Suggestion rule for built-in honors: TOP_MONTH, ATTENDANCE, IMPROVED, STAR; null for custom honors.
  rule          String?  @db.VarChar(20)
  publicDefault Boolean  @default(true)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  honors        Honor[]

  @@unique([schoolId, name])
}

model Honor {
  id          String    @id @default(cuid())
  schoolId    String
  typeId      String
  type        HonorType @relation(fields: [typeId], references: [id])
  studentId   String
  classId     String?
  /// "YYYY-MM" for monthly honors, or free text like "2026-27" / "Sports Day 2026".
  period      String    @db.VarChar(30)
  citation    String?   @db.VarChar(300)
  /// Shown on the honor board to everyone in the school.
  isPublic    Boolean   @default(true)
  createdById String
  createdAt   DateTime  @default(now())
  notifiedAt  DateTime?

  @@index([schoolId, period])
  @@index([studentId])
}
