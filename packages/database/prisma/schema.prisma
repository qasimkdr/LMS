generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlatformRole {
  SUPER_ADMIN
  PRINCIPAL
  STAFF
  TEACHER
  STUDENT
  PARENT
}

enum SchoolStatus {
  TRIAL
  ACTIVE
  GRACE_PERIOD
  READ_ONLY
  SUSPENDED
  CANCELLED
}

enum ApprovalStatus {
  DRAFT
  PENDING
  REVISION_REQUIRED
  RESUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum QuestionType {
  MCQ
  MULTI_SELECT
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
  LONG_ANSWER
  NUMERIC
  MATCHING
  ESSAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

model School {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  logoUrl         String?
  description     String?
  phone           String?
  email           String?
  address         String?
  primaryColor    String       @default("#2563eb")
  secondaryColor  String       @default("#7c3aed")
  timezone        String       @default("Asia/Karachi")
  status          SchoolStatus @default(TRIAL)
  trialEndsAt     DateTime?
  subscriptionEnd DateTime?
  graceEndsAt     DateTime?
  studentLimit    Int          @default(1000)
  teacherLimit    Int          @default(100)
  storageLimitMb  Int          @default(1024)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users               User[]
  classes             Class[]
  subjects            Subject[]
  teacherAssignments  TeacherAssignment[]
  approvalRequests    ApprovalRequest[]
  approvalPolicies    ApprovalPolicy[]
  attendanceSessions  AttendanceSession[]
  attendanceRecords   AttendanceRecord[]
  exams               Exam[]
  auditLogs           AuditLog[]

  @@index([status])
}

model User {
  id           String       @id @default(uuid())
  schoolId     String?
  role         PlatformRole
  email        String       @unique
  username     String?      @unique
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String?
  isActive     Boolean      @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  school               School?              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentProfile       StudentProfile?
  parentProfile        ParentProfile?
  teacherAssignments   TeacherAssignment[]
  requestedApprovals   ApprovalRequest[]     @relation("ApprovalRequester")
  reviewedApprovals    ApprovalRequest[]     @relation("ApprovalReviewer")
  attendanceSessions   AttendanceSession[]   @relation("AttendanceMarker")
  attendanceRecords    AttendanceRecord[]    @relation("AttendanceStudent")
  auditLogs            AuditLog[]

  @@index([schoolId, role])
}

model StudentProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  schoolId      String
  admissionNo   String
  classId       String?
  section       String?
  guardianPhone String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  class       Class?            @relation(fields: [classId], references: [id])
  parentLinks StudentParent[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, classId])
}

model ParentProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  schoolId  String
  createdAt DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  students StudentParent[]

  @@index([schoolId])
}

model StudentParent {
  studentId String
  parentId  String
  relation  String?

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
}

model Class {
  id           String   @id @default(uuid())
  schoolId     String
  name         String
  section      String?
  academicYear String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school               School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students             StudentProfile[]
  assignments          TeacherAssignment[]
  attendanceSessions   AttendanceSession[]
  exams                Exam[]

  @@unique([schoolId, name, section, academicYear])
  @@index([schoolId])
}

model Subject {
  id        String   @id @default(uuid())
  schoolId  String
  name      String
  code      String?
  createdAt DateTime @default(now())

  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]
  exams        Exam[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model TeacherAssignment {
  id        String   @id @default(uuid())
  schoolId  String
  teacherId String
  classId   String
  subjectId String
  createdAt DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([schoolId, teacherId, classId, subjectId])
  @@index([schoolId, teacherId])
  @@index([schoolId, classId])
}

model ApprovalPolicy {
  id              String   @id @default(uuid())
  schoolId        String
  actionKey       String
  requiresApproval Boolean @default(true)
  allowedForStaff Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, actionKey])
  @@index([schoolId])
}

model ApprovalRequest {
  id              String         @id @default(uuid())
  schoolId        String
  requesterId     String
  reviewerId      String?
  requestType     String
  entityType      String
  entityId        String?
  proposedData    Json
  status          ApprovalStatus @default(DRAFT)
  revision        Int            @default(1)
  principalRemark String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requester User   @relation("ApprovalRequester", fields: [requesterId], references: [id])
  reviewer  User?  @relation("ApprovalReviewer", fields: [reviewerId], references: [id])
  versions  ApprovalVersion[]

  @@index([schoolId, status])
  @@index([schoolId, requesterId])
}

model ApprovalVersion {
  id                String   @id @default(uuid())
  approvalRequestId String
  revision          Int
  proposedData      Json
  note              String?
  createdAt         DateTime @default(now())

  request ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@unique([approvalRequestId, revision])
}

model AttendanceSession {
  id         String   @id @default(uuid())
  schoolId   String
  classId    String
  date       DateTime
  markedById String
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school   School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class    Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  markedBy User               @relation("AttendanceMarker", fields: [markedById], references: [id])
  records  AttendanceRecord[]

  @@unique([schoolId, classId, date])
  @@index([schoolId, date])
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  schoolId  String
  sessionId String
  studentId String
  status    AttendanceStatus
  remark    String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  school  School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User              @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([schoolId, studentId, createdAt])
  @@index([schoolId, status, createdAt])
}

model Exam {
  id                 String   @id @default(uuid())
  schoolId           String
  classId            String
  subjectId          String
  createdById        String
  title              String
  instructions       String?
  durationMin        Int
  totalMarks         Decimal  @db.Decimal(8,2)
  passingMarks       Decimal? @db.Decimal(8,2)
  startsAt           DateTime?
  endsAt             DateTime?
  randomizeQuestions Boolean  @default(false)
  randomizeOptions   Boolean  @default(false)
  showResults        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class     Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([schoolId, classId, subjectId])
}

model Question {
  id            String       @id @default(uuid())
  examId        String
  type          QuestionType
  prompt        String
  explanation   String?
  marks         Decimal      @db.Decimal(8,2)
  correctAnswer Json?
  orderIndex    Int
  createdAt     DateTime     @default(now())

  exam    Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  options QuestionOption[]

  @@index([examId, orderIndex])
}

model QuestionOption {
  id         String  @id @default(uuid())
  questionId String
  label      String
  value      String
  isCorrect  Boolean @default(false)
  orderIndex Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, orderIndex])
}

model AuditLog {
  id         String   @id @default(uuid())
  schoolId   String?
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([actorId, createdAt])
}
